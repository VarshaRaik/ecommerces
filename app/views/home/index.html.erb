<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6 text-center">
      <% if user_signed_in? %>
        <div class="alert alert-success" role="alert">
          <h4 class="alert-heading">Welcome, <%= current_user.first_name.presence || current_user.email %>!</h4>
        </div>
        <%= link_to "Sign out", custom_logout_path, class: "btn btn-danger btn-lg mt-3" %>
      <% else %>
        <div class="alert alert-info" role="alert">
          <h4 class="alert-heading mb-4">Welcome to Ecommerce!</h4>
          <%= link_to "Sign in", new_user_session_path, class: "btn btn-primary btn-lg mx-2" %>
          <%= link_to "Sign up", new_user_registration_path, class: "btn btn-success btn-lg mx-2" %>
        </div>
      <% end %>
    </div>
  </div>
</div>