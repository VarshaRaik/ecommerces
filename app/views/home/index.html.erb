<% if user_signed_in? %>
  <p>Welcome, <%= current_user.first_name || current_user.email %>!</p>
  <%= link_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-secondary ml-3" %>
<% else %>
  <%= link_to "Sign in", new_user_session_path %> |
  <%= link_to "Sign up", new_user_registration_path %>
<% end %>